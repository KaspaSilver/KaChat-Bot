# ── KaChat Bot v2 / .env (only for running without the panel) ────────────────
# The bots themselves (keys, pairing codes) live in ./conf/bots.json, not here.

# kaspad gRPC (needs --utxoindex) and wRPC Borsh endpoints
NODE_GRPC=host-gateway:16110
NODE_WRPC=ws://host-gateway:17110

# mainnet or testnet-10
KASPA_NETWORK=mainnet

# Optional: a KaChat chat indexer, used to catch up on messages after downtime
KACHAT_INDEXER_URL=

# Optional: stratum bridge stats, for the mining bot's hashrate line and drop alerts
BRIDGE_STATS_URL=

# Optional: messages one bot may send per hour (each costs a network fee)
BOT_MAX_OUT_PER_HOUR=30
